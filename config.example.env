# Copy to config.env (git-ignored) on BOTH machines and fill in.
# windows/setup.ps1 creates config.env automatically with the Windows values detected.

# Tailscale MagicDNS names (see `tailscale status`). Short names work inside the tailnet.
WIN_HOST=it
MAC_HOST=my-mac

# RDP login for the Windows PC. For a Microsoft account this is the account email
# (password = Microsoft account password, NOT the Windows Hello PIN).
WIN_USER=you@outlook.com

# Local Windows profile name, used for SSH key login (C:\Users\<this>)
WIN_SSH_USER=green

# macOS short username (run `whoami` on the Mac)
MAC_USER=me
